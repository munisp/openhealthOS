# syntax=docker/dockerfile:1
# Wallet service image: Go service plus the Rust ledger binary it posts
# premium collections and payouts through (same subprocess seam as the
# claims orchestrator, ADR-0003).
FROM golang:1.22-alpine AS go-build
WORKDIR /src
COPY services/wallet-service/ ./
RUN CGO_ENABLED=0 go vet . && CGO_ENABLED=0 go build -trimpath -o /out/wallet-service .

FROM rust:1.82-alpine AS rust-build
WORKDIR /src
COPY services/ledger/ ./
RUN cargo build --release

FROM alpine:3.20
RUN adduser -D -u 10001 openhealth
USER openhealth
COPY --from=go-build /out/wallet-service /usr/local/bin/wallet-service
COPY --from=rust-build --chown=openhealth /src/target/release/oh_ledger /usr/local/bin/oh_ledger
ENV LEDGER=/usr/local/bin/oh_ledger
EXPOSE 8084
ENTRYPOINT ["/usr/local/bin/wallet-service"]
