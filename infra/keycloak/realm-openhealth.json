{
  "realm": "openhealth",
  "enabled": true,
  "displayName": "OpenHealth OS",
  "accessTokenLifespan": 900,
  "ssoSessionMaxLifespan": 28800,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "roles": {
    "realm": [
      { "name": "nurse", "description": "Facility nurse — consults, CHW supervision" },
      { "name": "doctor", "description": "Remote doctor — escalated telehealth queue" },
      { "name": "chw", "description": "Community health worker — household tasks" },
      { "name": "facility-admin", "description": "Facility administrator — registry writes" },
      { "name": "scheme-operator", "description": "Scheme/HMO operator — claims console" },
      { "name": "auditor", "description": "Read-only audit access (SHR + consent logs)" }
    ]
  },
  "clientScopes": [
    {
      "name": "facility",
      "description": "Facility attribution claim — every API write is attributed to a facility",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "facility_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "facility_id",
            "claim.name": "facility_id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
    ,
    {
      "name": "smart-patient-read",
      "description": "SMART App Launch patient-level read scopes (IPA v1.0.0 — patient/*.read for the IPA support set)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "smart-system-read",
      "description": "SMART Backend Services system-level read (bulk $export pipelines: system/Patient.read, system/Immunization.read, system/Observation.read, ...)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "smart-launch",
      "description": "SMART launch context scopes: launch/patient + fhirUser + offline_access (patient PWA / howUdeyChat)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    }
  ],
  "defaultDefaultClientScopes": ["openid", "profile", "email", "facility"],
  "clients": [
    {
      "clientId": "openhealth-app",
      "name": "OpenHealth offline-first app (edge)",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost/*", "openhealth://callback"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "openhealth-gateway",
      "name": "Service-to-service gateway client",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "secret": "change-me-in-production"
    },
    {
      "clientId": "openhealth-patient",
      "name": "Patient-facing client (PWA + howUdeyChat) — IPA conformance client",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://patient.openhealth.example/*", "openhealth-patient://callback"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "optionalClientScopes": ["smart-patient-read", "smart-launch"]
    },
    {
      "clientId": "openhealth-bulk-export",
      "name": "SMART Backend Services — bulk-export-service (client_credentials + RS384 JWT)",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "optionalClientScopes": ["smart-system-read"]
    }
  ]
}
