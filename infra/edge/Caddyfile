# OpenHealth OS edge ingress — Caddy (ADR-0042).
#
# Replaces the bare-nginx PWA server on facility edge nodes. One static
# binary, no Lua, no external deps; survives power loss (atomic config,
# crash-safe cert storage).
#
# TLS doctrine for offline Nigeria: there is no public ACME on a facility
# LAN, so Caddy's INTERNAL CA issues the node cert; the CA root is pushed
# to facility devices by the same MDM/provisioning channel that installs
# the PWA. When a node gets a public hostname + connectivity (LGA hubs),
# flip `tls internal` to a real domain and Caddy does ACME automatically.

{
	# No telemetry, no update pings — edge nodes are often air-gapped.
	admin off
	auto_https disable_redirects # keep :80 for the LAN; phones roam onto it
	local_certs
}

:443, :80 {
	root * /srv/pwa

	# Security headers — the PWA talks PHI; these are the baseline.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
		-Server
	}

	# Local edge APIs (same origin, no CORS): outbox status, telemetry.
	handle /api/* {
		reverse_proxy sync-agent:8080 {
			# Edge services are stdlib Go; generous timeouts for cold
			# starts after a power cycle.
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	# PWA static assets + SPA fallback. Immutable cache for hashed assets.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}

	tls internal

	log {
		output file /var/log/caddy/access.log {
			roll_keep 3
			roll_size 10MiB
		}
		format json # ships to the telemetry outbox via the collector
	}
}
