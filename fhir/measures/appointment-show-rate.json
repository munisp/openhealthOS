{
  "resourceType": "Measure",
  "url": "https://openhealthos.org/fhir/Measure/appointment-show-rate",
  "name": "appointment_show_rate",
  "title": "Appointment show rate",
  "description": "Booked appointments in the period that were fulfilled (not noshow, not cancelled) — access quality per facility.",
  "scoring": {"coding": [{"system": "http://hl7.org/fhir/measure-scoring", "code": "proportion"}]},
  "group": [{
    "population": [
      {
        "code": {"coding": [{"system": "http://terminology.hl7.org/CodeSystem/measure-population", "code": "denominator"}]},
        "extension": [{
          "url": "https://openhealthos.org/fhir/StructureDefinition/openhealth-population-criteria",
          "value": {"resourceType": "Appointment",
                    "criteria": [{"path": "status", "op": "in", "value": ["booked", "fulfilled", "noshow"]}]}
        }]
      },
      {
        "code": {"coding": [{"system": "http://terminology.hl7.org/CodeSystem/measure-population", "code": "numerator"}]},
        "extension": [{
          "url": "https://openhealthos.org/fhir/StructureDefinition/openhealth-population-criteria",
          "value": {"resourceType": "Appointment",
                    "criteria": [{"path": "status", "op": "eq", "value": "fulfilled"}]}
        }]
      }
    ]
  }]
}
